{
  "_readme": "Paste the \"screens\" object into a skin's \"layout\" section (themes_versions.content.layout). With it, the People tab is built from these blocks instead of the built-in list.",
  "layout": {
    "screens": {
      "people": {
        "title": "People",
        "blocks": [
          { "type": "storyRail", "style": "cards", "source": "contacts" },
          { "type": "chips", "items": ["online", "all"] },
          { "type": "note", "text": "Showing your contacts." },
          { "type": "section", "title": "Contacts" },
          { "type": "list", "source": "contacts", "row": "compact", "limit": 60 }
        ]
      }
    }
  }
}
